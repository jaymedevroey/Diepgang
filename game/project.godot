; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Diepgang"
config/description="Co-op opgravingsgame. Werktitel."
run/main_scene="res://src/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Tuning="*res://src/main/tuning.gd"
Settings="*res://src/main/settings.gd"
Sfx="*res://src/audio/sfx.gd"
SteamService="*res://src/net/steam_service.gd"
Net="*res://src/net/net_session.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true

[shader_globals]

magma_height={
"type": "float",
"value": -10000.0
}
magma_heat_m={
"type": "float",
"value": 12.0
}

[voxel]

threads/count/minimum=4
threads/count/ratio_over_max=0.0
